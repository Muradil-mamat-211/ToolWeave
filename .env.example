# Optional machine-local overrides. Never commit the real .env/env.local.sh.
TOOLWEAVE_SOURCE_ROOT=/path/to/ToolWeave
TOOLWEAVE_ASSET_ROOT=/path/to/local/assets
TOOLWEAVE_MODELS_ROOT=/path/to/local/assets/models
TOOLWEAVE_DATA_ROOT=/path/to/local/assets/stage1_format_rl/data
TOOLWEAVE_SHARED_DATA_ROOT=/path/to/local/assets/data
TOOLWEAVE_ARTIFACTS_ROOT=/path/to/local/assets/stage1_format_rl/artifacts
TOOLWEAVE_OUTPUTS_ROOT=/path/to/local/outputs
TOOLWEAVE_LOGS_ROOT=/path/to/local/logs
TOOLWEAVE_REPORTS_ROOT=/path/to/local/reports
TOOLWEAVE_EVALS_ROOT=/path/to/local/evals
TOOLWEAVE_CACHE_ROOT=/path/to/local/cache
TOOLWEAVE_TEMP_ROOT=/path/to/local/runtime
TOOLWEAVE_SHORT_TEMP_ROOT=/short/local/runtime
TOOLWEAVE_PYTHON=/path/to/conda/env/bin/python
TOOLWEAVE_SYNTH_PYTHON=/path/to/synthesis/env/bin/python
TOOLWEAVE_CONDA_ENV=rods
TOOLWEAVE_GENERATOR_ENDPOINT=http://127.0.0.1:8000/v1
