{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolweave.planner_input.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "data_type", "involved_classes", "original_task", "initial_environment", "generation_contract"],
  "properties": {
    "schema_version": {"const": "toolweave.planner_input.v2"},
    "sample_id": {"type": "string", "minLength": 1},
    "data_type": {"enum": ["multi_turn_base", "multi_turn_miss_func", "multi_turn_miss_param", "multi_turn_long_context"]},
    "involved_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "original_task": {
      "type": "object", "additionalProperties": false,
      "required": ["user_queries", "reference_ground_truth", "initial_tool_definitions", "tool_updates"],
      "properties": {
        "user_queries": {"type": "array"},
        "reference_ground_truth": {"type": "array"},
        "initial_tool_definitions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "tool_updates": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["turn_id", "tools"],
          "properties": {"turn_id": {"type": "integer", "minimum": 1}, "tools": {"type": "array", "minItems": 1, "items": {"type": "object"}}}
        }}
      }
    },
    "initial_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["config", "runtime_snapshot_view", "long_context"],
      "properties": {"config": {"type": "object"}, "runtime_snapshot_view": {"type": ["object", "null"]}, "long_context": {"type": "boolean"}}
    },
    "generation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_planned_turns", "maximum_planned_turns", "maximum_final_turns", "functions_per_turn", "one_class_per_turn", "reserved_recovery_turns", "argument_limits"],
      "properties": {
        "minimum_planned_turns": {"const": 2}, "maximum_planned_turns": {"enum": [4, 5]},
        "maximum_final_turns": {"const": 5}, "functions_per_turn": {"const": [1, 3]},
        "one_class_per_turn": {"const": true}, "reserved_recovery_turns": {"enum": [0, 1]},
        "argument_limits": {
          "type": "object", "additionalProperties": false,
          "required": ["max_string_characters", "max_collection_items"],
          "properties": {"max_string_characters": {"const": 200}, "max_collection_items": {"const": 5}}
        }
      }
    },
    "retry_feedback": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"data_type": {"enum": ["multi_turn_miss_func", "multi_turn_miss_param"]}}},
      "then": {"properties": {"generation_contract": {"properties": {"maximum_planned_turns": {"const": 4}, "reserved_recovery_turns": {"const": 1}}}}},
      "else": {"properties": {"generation_contract": {"properties": {"maximum_planned_turns": {"const": 5}, "reserved_recovery_turns": {"const": 0}}}}}
    },
    {
      "if": {"properties": {"data_type": {"const": "multi_turn_long_context"}}},
      "then": {"properties": {"initial_environment": {"properties": {"long_context": {"const": true}}}}},
      "else": {"properties": {"initial_environment": {"properties": {"long_context": {"const": false}}}}}
    }
  ]
}
